{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "@project-air/web#build": {
      "dependsOn": ["^build", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": ["dist/**", "build/**"]
    },
    "@project-air/web#lint": {
      "dependsOn": ["^lint", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@project-air/web#typecheck": {
      "dependsOn": ["^build", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@project-air/sync#lint": {
      "dependsOn": ["^lint", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@project-air/sync#typecheck": {
      "dependsOn": ["^build", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@project-air/sync#test": {
      "dependsOn": ["build", "@project-air/crdt#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    }
  }
}
