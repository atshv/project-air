{
  "name": "@project-air/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "C++20 canvas engine compiled to WebAssembly with the thin TypeScript bridge createEngine(canvas, options) and the gesture-to-operation logic layer.",
  "main": "./dist/bridge/engine.js",
  "types": "./dist/bridge/engine.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bridge/engine.d.ts",
      "import": "./dist/bridge/engine.js"
    },
    "./input.js": {
      "types": "./dist/bridge/input.d.ts",
      "import": "./dist/bridge/input.js"
    },
    "./logic/operations.js": {
      "types": "./dist/logic/operations.d.ts",
      "import": "./dist/logic/operations.js"
    },
    "./logic/document-port.js": {
      "types": "./dist/logic/document-port.d.ts",
      "import": "./dist/logic/document-port.js"
    },
    "./logic/history.js": {
      "types": "./dist/logic/history.d.ts",
      "import": "./dist/logic/history.js"
    },
    "./bridge/view-persistence.js": {
      "types": "./dist/bridge/view-persistence.d.ts",
      "import": "./dist/bridge/view-persistence.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.logic.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "node --test test/*.test.mjs"
  }
}
