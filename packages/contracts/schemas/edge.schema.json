{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-air.dev/contracts/0.2.0/edge.schema.json",
  "title": "Edge",
  "description": "A connection between two note cards on one board. Edges join cards only; a card-to-zone edge is invalid in v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "boardId", "from", "to", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, time-sortable.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boardId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from": {
      "$ref": "#/$defs/card-endpoint",
      "description": "Source endpoint; only a note card is allowed."
    },
    "to": {
      "$ref": "#/$defs/card-endpoint",
      "description": "Target endpoint; only a note card is allowed."
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "$defs": {
    "card-endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "const": "card",
          "description": "Only cards can be edge endpoints in v1."
        },
        "id": {
          "type": "string",
          "description": "Reference to card.id.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
