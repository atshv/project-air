{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-air.dev/contracts/0.2.0/zone.schema.json",
  "title": "Zone",
  "description": "A zone groups cards on one board. Zones are not nested in v1: a zone has no parent zone, only its board.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "boardId", "title", "x", "y", "width", "height", "z", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, time-sortable.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boardId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "x": {
      "type": "number",
      "description": "World position in pixels (Float64)."
    },
    "y": {
      "type": "number",
      "description": "World position in pixels (Float64)."
    },
    "width": {
      "type": "number",
      "description": "Width in pixels; the zone minimum is 256.",
      "minimum": 256
    },
    "height": {
      "type": "number",
      "description": "Height in pixels; the zone minimum is 192.",
      "minimum": 192
    },
    "z": {
      "type": "string",
      "description": "Fractional index inside the zone layer.",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z]{1,64}$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
