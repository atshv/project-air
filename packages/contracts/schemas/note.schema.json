{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-air.dev/contracts/0.2.0/note.schema.json",
  "title": "Note",
  "description": "A note exists once in its workspace (AD-4); cards only reference it. The note body is the editor document and is added in the editor stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspaceId", "title", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, time-sortable. The stable identity a card points at.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
