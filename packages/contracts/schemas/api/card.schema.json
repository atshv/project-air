{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-air.dev/contracts/0.1.0/api/card.schema.json",
  "title": "Note card REST envelopes",
  "description": "Request and response envelopes of the card resource of contract 0.1.0. Every envelope carries a requestId; the entity is the P1-01 card schema, so a resource response can be validated without restating the model. Bodies are closed (additionalProperties false).",
  "$ref": "#/$defs/envelopes",
  "$defs": {
    "uuid": {
      "type": "string",
      "description": "UUIDv7 identifier, time-sortable.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "description": "UUIDv7 request id, echoed in the matching response.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9A-Za-z._~-]{1,256}$",
      "description": "Opaque pagination cursor taken from the previous nextCursor."
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9A-Za-z._~-]{1,256}$",
      "description": "Cursor of the next page; null at the end of the list."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50,
      "description": "Maximum items per page."
    },
    "entity": {
      "$ref": "../card.schema.json",
      "description": "The P1-01 card entity; a card is a note placement (AD-4)."
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "description": "Client-settable fields of a new card; the server assigns id and timestamps.",
      "required": [
        "boardId",
        "noteId",
        "x",
        "y",
        "width",
        "height",
        "z"
      ],
      "properties": {
        "boardId": {
          "$ref": "#/$defs/uuid"
        },
        "noteId": {
          "$ref": "#/$defs/uuid"
        },
        "zoneId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Parent zone; null or omitted means directly on the board.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "x": {
          "type": "number",
          "description": "World position in pixels."
        },
        "y": {
          "type": "number",
          "description": "World position in pixels."
        },
        "width": {
          "type": "number",
          "minimum": 176,
          "description": "Width in pixels; minimum 176."
        },
        "height": {
          "type": "number",
          "minimum": 80,
          "description": "Height in pixels; minimum 80."
        },
        "z": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z]{1,64}$",
          "description": "Fractional index inside the note-card layer."
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Only the changed fields; at least one is required.",
      "properties": {
        "zoneId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Parent zone; null moves the card directly onto the board."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 176
        },
        "height": {
          "type": "number",
          "minimum": 80
        },
        "z": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z]{1,64}$"
        }
      }
    },
    "list-request": {
      "title": "list-request",
      "description": "Query envelope for listing cards; the requestId is echoed in the response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      }
    },
    "list-response": {
      "title": "list-response",
      "description": "List response with one page of cards and the cursor of the next page.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "items",
        "nextCursor"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "items": {
          "type": "array",
          "description": "The cards on this page; empty when the list is empty.",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/nextCursor"
        }
      }
    },
    "response": {
      "title": "response",
      "description": "Single-card response for get, create and update; the server assigns id and timestamps.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "card"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "card": {
          "$ref": "#/$defs/entity"
        }
      }
    },
    "create-request": {
      "title": "create-request",
      "description": "Create body for one card; the response is the single-resource response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "card"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "card": {
          "$ref": "#/$defs/create"
        }
      }
    },
    "update-request": {
      "title": "update-request",
      "description": "Update body for one card; changes must not be empty.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "cardId",
        "changes"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "cardId": {
          "$ref": "#/$defs/uuid"
        },
        "changes": {
          "$ref": "#/$defs/changes"
        }
      }
    },
    "delete-request": {
      "title": "delete-request",
      "description": "Delete body for one card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "cardId"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "cardId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "delete-response": {
      "title": "delete-response",
      "description": "Delete confirmation naming the deleted card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "deletedId"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "deletedId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "envelopes": {
      "title": "Note card resource envelopes",
      "description": "One closed request or response envelope of the card resource.",
      "oneOf": [
        {
          "$ref": "#/$defs/list-request"
        },
        {
          "$ref": "#/$defs/list-response"
        },
        {
          "$ref": "#/$defs/response"
        },
        {
          "$ref": "#/$defs/create-request"
        },
        {
          "$ref": "#/$defs/update-request"
        },
        {
          "$ref": "#/$defs/delete-request"
        },
        {
          "$ref": "#/$defs/delete-response"
        }
      ]
    }
  }
}
