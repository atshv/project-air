{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-air.dev/contracts/0.3.0/card.schema.json",
  "title": "Note card",
  "description": "The placement of one note on one board (AD-4). A card references its note and never embeds note content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "boardId", "noteId", "x", "y", "width", "height", "z", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, time-sortable.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boardId": {
      "type": "string",
      "description": "The board the card is placed on.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "noteId": {
      "type": "string",
      "description": "Reference to note.id; the note content is not part of the card.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "zoneId": {
      "type": ["string", "null"],
      "description": "Parent zone. Omitted or null means the card sits directly on the board.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "x": {
      "type": "number",
      "description": "World position in pixels (Float64)."
    },
    "y": {
      "type": "number",
      "description": "World position in pixels (Float64)."
    },
    "width": {
      "type": "number",
      "description": "Width in pixels; the card minimum is 176.",
      "minimum": 176
    },
    "height": {
      "type": "number",
      "description": "Height in pixels; the card minimum is 80.",
      "minimum": 80
    },
    "z": {
      "type": "string",
      "description": "Fractional index inside the note-card layer; lexicographic order, insertion never renumbers.",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z]{1,64}$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
