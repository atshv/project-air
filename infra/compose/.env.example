# Environment variables read by infra/compose/compose.yaml (P0-07, extended by P3-01).
#
# Copy this file to `infra/compose/.env` and fill in local values; `.env` is gitignored and
# must never be committed. A variable left empty falls back to the local development default
# in compose.yaml. These are local-only values, never production secrets.
#
# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=
#
# SeaweedFS S3
SEAWEEDFS_S3_HOST_PORT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
#
# Mailpit
MAILPIT_SMTP_HOST_PORT=
MAILPIT_HTTP_HOST_PORT=
#
# Ory Kratos (pinned in P3-01, configured in P3-03)
KRATOS_DB_NAME=
KRATOS_PUBLIC_HOST_PORT=
KRATOS_ADMIN_HOST_PORT=
#
# Per-slot application database role (created by tools/dev/setup; the password is
# generated on first setup or read from the environment; never commit a value)
APP_USER_PASSWORD=
#
# Read by the Node services (services/platform, services/auth), not by this compose file.
# Export them in the shell or in the gitignored env file; names only, never commit values.
# DATABASE_URL=
# PORT=
# AUTH_PORT=
# NODE_ENV=
# LOG_LEVEL=
# AUTH_SESSION_SECRET=
