# Environment variables read by infra/compose/compose.yaml (P0-07).
#
# Copy this file to `infra/compose/.env` and fill in local values; `.env` is gitignored and
# must never be committed. A variable left empty falls back to the local development default
# in compose.yaml. These are local-only values, never production secrets.
#
# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=
#
# SeaweedFS S3
SEAWEEDFS_S3_HOST_PORT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
#
# Mailpit
MAILPIT_SMTP_HOST_PORT=
MAILPIT_HTTP_HOST_PORT=
