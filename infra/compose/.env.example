# Environment variables read by infra/compose/compose.yaml (P0-07, extended by P3-01 and P3-03).
#
# Copy this file to `infra/compose/.env` and fill in local values; `.env` is gitignored and
# must never be committed. A variable left empty falls back to the local development default
# in compose.yaml. These are local-only values, never production secrets.
#
# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=
#
# SeaweedFS S3
SEAWEEDFS_S3_HOST_PORT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
#
# Mailpit
MAILPIT_SMTP_HOST_PORT=
MAILPIT_HTTP_HOST_PORT=
#
# Ory Kratos identity service (pinned in P3-01, configured in P3-03)
# The DSN, secrets and URLs stay in the environment; `tools/dev/setup` generates
# the three secrets on first run and stores them in the gitignored .env.
KRATOS_DSN=
KRATOS_DB_NAME=
KRATOS_PUBLIC_HOST_PORT=
KRATOS_ADMIN_HOST_PORT=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
KRATOS_ADMIN_TOKEN=
KRATOS_COOKIE_SECURE=
KRATOS_LOG_LEVEL=
KRATOS_SMTP_CONNECTION_URI=
KRATOS_BROWSER_RETURN_URL=
#
# Per-slot application database role (created by tools/dev/setup; the password is
# generated on first setup or read from the environment; never commit a value)
APP_USER_PASSWORD=
#
# Read by the Node services (services/platform, services/auth), not by this compose file.
# Export them in the shell or in the gitignored env file; names only, never commit values.
# DATABASE_URL=
# PORT=
# AUTH_PORT=
# NODE_ENV=
# LOG_LEVEL=
# AUTH_SESSION_SECRET=
# KRATOS_PUBLIC_URL=
# KRATOS_ADMIN_URL=
# AUTH_TEST_MODE=

# Backend services (names only; values come from .polier-slot / tools/dev/setup)
APP_DATABASE_URL=
AUTH_SERVICE_URL=
