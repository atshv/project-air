{
  "version": 1,
  "limits": {
    "max_attempts_per_task": 3,
    "max_in_progress": 3,
    "max_review_rounds": 3
  },
  "scope": {
    "protected_paths": [
      ".env",
      ".env.*",
      "secrets/**",
      "**/*.pem",
      "**/*.key",
      "**/id_rsa*",
      "reference/**",
      "docs/owner/**"
    ]
  },
  "dependencies": {
    "approval": true,
    "manifests": [
      "package.json",
      "pnpm-lock.yaml",
      "compose.yaml"
    ]
  },
  "approvals": {
    "actions": [
      "new_dependency",
      "scope_change",
      "merge_to_base",
      "release",
      "reopen_done",
      "protected_path",
      "state_override"
    ],
    "approver": "owner"
  },
  "commands": {
    "deny": [
      "git push*",
      "npm publish*",
      "pnpm publish*",
      "yarn publish*",
      "docker push*",
      "gh release*",
      "kubectl apply*",
      "kubectl delete*",
      "terraform apply*",
      "rm -rf /*"
    ],
    "lead_only": [
      "*tools/state.py set*",
      "*tools/approve.py grant*",
      "*tools/approve.py deny*",
      "*tools/worktree.py finish*"
    ],
    "warn": [
      "*kill*",
      "*pkill*",
      "killall*"
    ]
  },
  "checks": {
    "review_before_done": false,
    "handoff_before_done": false,
    "run_record": false,
    "disjoint_scopes": true
  },
  "budget": {
    "max_tokens_per_task": null,
    "warn_at": 0.8
  }
}
