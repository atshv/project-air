{
  "name": "project-air",
  "version": "0.0.0",
  "private": true,
  "description": "Project air monorepo: workspace root, tooling and build orchestration.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -b tsconfig.json",
    "test": "turbo run test",
    "clean": "rm -rf .turbo node_modules coverage"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
