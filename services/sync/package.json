{
  "name": "@project-air/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime sync service: WebSocket protocol 0.3.0, platform authorization and a durable per-board update log (serverSeq committed before ack).",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
