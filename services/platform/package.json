{
  "name": "@project-air/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API for workspaces, boards, notes and permissions: typed configuration, a node:http router, health endpoints, PostgreSQL pool and migration runner.",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "node --test --test-concurrency=1 test/*.test.mjs test/migrations/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
