{
  "name": "@project-air/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Project air web app: React 19 + Vite SPA for the product UI.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "node --test test/*.test.mjs",
    "e2e": "playwright test",
    "e2e:manual": "E2E_KRATOS=1 playwright test e2e/manual"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
